# il faut lancer les test avec la session en memory et pas en cookie sinon le loginAs fonctionne pas
SESSION_DRIVER=memory

# "localhost" résout en IPv6 (::1) sous Node/macOS, alors que les tests se
# connectent en dur sur 127.0.0.1 (cf tests/functional/group_chat.spec.ts) :
# sans ceci, le serveur écoute sur une interface différente et toutes les
# connexions websocket échouent.
HOST=127.0.0.1

# Base dédiée aux tests : évite d'écraser les données de la base de dev (pomodb)
DB_DATABASE=pomodb_test