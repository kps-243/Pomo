<!DOCTYPE html>
<html lang="fr" class="h-full">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />

    <title inertia>
      Pomo
    </title>

    <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
    <link
      href="https://fonts.bunny.net/css?family=instrument-sans:400,400i,500,500i,600,600i,700,700i&display=swap"
      rel="stylesheet"
    />

    {{--
      Applique le thème avant le premier rendu, sinon la page apparaît en clair
      le temps que Vue démarre (flash). La clé de stockage est celle de `useDark()`
      (@vueuse/core), utilisé par inertia/composables/use_theme.ts.
    --}}
    <script>
      (() => {
        try {
          const stored = localStorage.getItem('vueuse-color-scheme') || 'auto'
          const isDark =
            stored === 'dark' ||
            (stored === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches)
          document.documentElement.classList.toggle('dark', isDark)
        } catch {
          /* localStorage indisponible (navigation privée stricte) : on reste en clair. */
        }
      })()
    </script>

    @vite(['inertia/app/app.ts', `inertia/pages/${page.component}.vue`])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body class="min-h-full font-sans">
    @inertia()
  </body>

</html>
